# Time zone used by the container
TZ=Asia/Tokyo

# External Web port on the NAS
EXTERNAL_PORT=9109

# Virtual Drive data directory on the NAS
PROJECT_ROOT=/volume1/docker/virtual-drive

# NAS root available to the host-namespace bridge
NAS_ROOT=/volume1

# Default folder opened by the NAS image picker.
# Change this to an existing folder on your NAS.
NAS_IMPORT_ROOT=/volume1

# Automatically restore active mounts after container restart
AUTO_RESTORE=true

# Web login
VD_USER=admin
# Leave empty to let the application generate a random password on first start.
VD_PASSWORD=

# Application version
APP_VERSION=2.0.13
